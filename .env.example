# Copy this file to .env and fill in the values. Never commit .env.

# --- Core ---------------------------------------------------------------
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# For a public deployment, list the site's origin, e.g. https://nearbygo.example.lk
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Database (MySQL 8.0) -----------------------------------------------
DB_ENGINE=mysql
DB_NAME=nearbygo
DB_USER=nearbygo
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# For a quick trial without MySQL, set DB_ENGINE=sqlite (the other DB_ values are then ignored).

# --- Private reference location (never shown to visitors) ---------------
# Your home point used only to check the 25 km radius. Leave blank to check
# recorded distances only.
NEARBYGO_REFERENCE_LAT=
NEARBYGO_REFERENCE_LNG=
NEARBYGO_RADIUS_KM=25

# --- Map tiles (TBD-04) -------------------------------------------------
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# --- Sessions -----------------------------------------------------------
# Visitor plan lifetime in seconds (default 7 days).
SESSION_COOKIE_AGE=604800
# Administrators are signed out after this many seconds without activity.
ADMIN_IDLE_TIMEOUT=1800

# --- Production (HTTPS) -------------------------------------------------
# Set USE_HTTPS=True when the site is served over HTTPS. This turns on secure
# cookies, HTTPS redirects and HSTS. Set BEHIND_PROXY=True if a proxy such as
# Nginx terminates HTTPS and forwards X-Forwarded-Proto.
USE_HTTPS=False
BEHIND_PROXY=False
